{
  "name": "demoscene-cli",
  "version": "1.0.0",
  "description": "Terminal-based demoscene visualization tool",
  "type": "module",
  "bin": {
    "demoscene-cli": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --outfile=dist/index.js --external:react --external:ink && chmod +x dist/index.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "demoscene",
    "visualization",
    "terminal",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}

